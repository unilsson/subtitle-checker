# Copy to .env, insert your API keys, and run docker compose up -d --build.
# Change the published HOST port to an unused port on ThinkPad (e.g. 8105).
# Container port 8097 remains unchanged. Docker Compose reads these variables from .env.
SUBTITLE_CHECKER_PORT=8097
# Bind to all host interfaces (LAN/VPN). For localhost-only access, use 127.0.0.1.
SUBTITLE_CHECKER_BIND=0.0.0.0

# For Docker on ThinkPad, point to a reachable Radarr address, not localhost.
RADARR_URL=http://192.168.1.14:7878
RADARR_API_KEY=replace_with_radarr_api_key
OPENSUBTITLES_API_KEY=replace_with_your_opensubtitles_consumer_key

# Search results are cached to avoid repeated OpenSubtitles requests.
CACHE_HOURS=24
REQUEST_DELAY_MS=500
# 0 disables background/automatic scans. Start scans manually from the UI.
AUTO_SCAN_HOURS=0
# 0 scans all missing movies, >0 limits each scan batch.
MAX_SCAN_MOVIES=0

# Sprint 2: Compare available Radarr releases with OpenSubtitles.
CHECK_RELEASES=true
RELEASE_CACHE_HOURS=24
# Limit expensive Radarr indexer searches per scan; 0 = unlimited.
MAX_RELEASE_SEARCHES=20
